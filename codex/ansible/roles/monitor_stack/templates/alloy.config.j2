logging {
  level  = "info"
  format = "logfmt"
}

prometheus.scrape "monitor" {
  targets = [
    { "__address__" = "127.0.0.1:8428", "job" = "victoriametrics" },
    { "__address__" = "127.0.0.1:9428", "job" = "victorialogs" },
    { "__address__" = "127.0.0.1:10428", "job" = "victoriatraces" },
    { "__address__" = "127.0.0.1:8081", "job" = "mcp-victoriametrics" },
    { "__address__" = "127.0.0.1:8082", "job" = "mcp-victorialogs" },
    { "__address__" = "127.0.0.1:8083", "job" = "mcp-victoriatraces" },
    { "__address__" = "127.0.0.1:9100", "job" = "node" },
    { "__address__" = "127.0.0.1:8888", "job" = "otel-collector" },
    { "__address__" = "127.0.0.1:3000", "job" = "grafana" },
  ]
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://127.0.0.1:8428/api/v1/write"
  }
}

loki.source.journal "local" {
  forward_to = [loki.write.local.receiver]
  labels     = { instance = "{{ inventory_hostname }}" }
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:9428/insert/loki/api/v1/push"
  }
}
