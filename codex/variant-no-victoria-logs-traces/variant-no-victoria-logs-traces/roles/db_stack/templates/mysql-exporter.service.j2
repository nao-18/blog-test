[Unit]
Description=Prometheus MySQL Exporter
After=network-online.target {{ mysql_service }}.service
Requires={{ mysql_service }}.service

[Service]
User=nobody
Group={{ 'nogroup' if ansible_facts.os_family == 'Debian' else 'nobody' }}
ExecStart=/usr/local/bin/mysqld_exporter --config.my-cnf=/etc/mysqld-exporter/.my.cnf --web.listen-address={{ admin_bind_address }}:9104
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
