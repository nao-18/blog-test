[Unit]
Description={{ item.name }} MCP Server
After=network-online.target
Wants=network-online.target

[Service]
User=victoria
Group=victoria
Environment=HOME=/var/lib/victoria
Environment={{ item.backend_name }}={{ item.backend_url }}
Environment=MCP_SERVER_MODE=http
Environment=MCP_LISTEN_ADDR={{ admin_bind_address }}:{{ item.listen_port }}
{{ item.extra_environment | default('') }}
ExecStart=/usr/local/bin/{{ item.binary }}
Restart=on-failure
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
