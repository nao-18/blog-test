    {
      "id": 6,
      "title": "Connection usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * mysql_global_status_threads_connected{job=\"mysql\",instance=~\"${instance:regex}\"} / mysql_global_variables_max_connections{job=\"mysql\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ]
    },
