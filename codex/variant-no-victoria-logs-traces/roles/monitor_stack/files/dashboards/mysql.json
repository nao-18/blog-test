      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "mysql_up{job=\"mysql\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Queries / questions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(mysql_global_status_queries{job=\"mysql\",instance=~\"${instance:regex}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} queries",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(mysql_global_status_questions{job=\"mysql\",instance=~\"${instance:regex}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} questions",
          "range": true,
          "instant": false
        }
      ]
    },
